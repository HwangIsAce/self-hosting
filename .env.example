# RunPod Pod 엔드포인트 (각 Pod 생성 후 받은 URL)
# 예시: https://xxx-llm-1234.runpod.net
RUNPOD_LLM_ENDPOINT=https://your-llm-pod.runpod.net
RUNPOD_VLM_ENDPOINT=https://your-vlm-pod.runpod.net
RUNPOD_DOCLING_ENDPOINT=https://your-docling-pod.runpod.net

# RunPod API 키 (선택사항, Pod 보호용)
RUNPOD_API_KEY=your-api-key-here

# API Gateway 서버 설정
HOST=0.0.0.0
PORT=8000
DEBUG=false

# HTTP 클라이언트 설정
REQUEST_TIMEOUT=300
MAX_RETRIES=3
RETRY_DELAY=1.0
MAX_CONNECTIONS=100
MAX_KEEPALIVE_CONNECTIONS=20

# CORS 설정
CORS_ORIGINS=["*"]

# 로깅
LOG_LEVEL=INFO

# 캐싱 (선택사항)
ENABLE_CACHE=false
CACHE_URL=redis://localhost:6379
